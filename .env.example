# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=syntiiq

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Session Configuration
# Number of days after which inactive sessions are purged (default: 30)
SESSION_EXPIRATION_DAYS=30

# JWT Configuration (RS256)
JWT_PRIVATE_KEY_PATH=./keys/private_key_pkcs8.pem
JWT_PUBLIC_KEY_PATH=./keys/public_key.pem

# Password pepper (generate a secure random string)
PASSWORD_PEPPER=your_pepper_here

# User Business Owner (seed)
ADMIN_EMAIL=owner@syntiiq.com
ADMIN_PASSWORD=Admin123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Business Owner
ADMIN_BUSINESS_NAME=SyntiIQ Demo Store

# Mail Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=onboarding@resend.dev

# Stripe (subscription plans - staging/prod)
# Leave unset for dev; seed uses placeholders. Set to real Stripe Price IDs for staging/prod.
# STRIPE_PRICE_BASIC=price_xxx
# STRIPE_PRICE_PRO=price_yyy

# --- CI/CD (GitHub Actions) ---
# Register as Secrets in: Settings > Secrets and variables > Actions
# Do NOT use in .env local; only for CI workflows
#
# Required for CI (ci.yml) + PR Review + dev-commit-notify:
#   DISCORD_WEBHOOK=https://discord.com/api/webhooks/... (optional; enables Discord notifications)
#
# Required for PR Review (pr-review.yml):
#   SONAR_TOKEN=your_sonarcloud_token (SonarCloud analysis and quality gate)
#   GEMINI_API_KEY=your_google_ai_api_key (AI code review — specialist)
#   GROQ_API_KEY=your_groq_api_key (summarizations, roast, diff condensation — orchestrator)
#
# PR Review — Thread per PR (required):
#   Webhook MUST be in a Discord forum channel. One thread is created per PR; CI, review,
#   commits, and closed notifications all go to that thread. Thread ID stored in PR comment.
#   GITHUB_TOKEN, GITHUB_REPOSITORY — auto-set in Actions.
#
# Optional fallback: DISCORD_THREAD_ID=1234567890 (single thread for all PRs; legacy)
#
# Optional variables (Settings > Variables):
#   GEMINI_MODEL=gemini-2.5-flash (specialist)
#   GROQ_MODEL=llama-3.3-70b-versatile (orchestrator)
#
# GITHUB_TOKEN is automatically provided by Actions.
#
# Optional — Use GitHub App (bot) for PR review comments instead of GITHUB_TOKEN:
#   GH_APP_ID, GH_INSTALLATION_ID, GH_APP_PRIVATE_KEY (secret names cannot start with GITHUB_)
#
# Coverage: Jest outputs coverage/coverage-final.json (json reporter) for PR comments.
#
# --- GitHub App (bot for issue:create + PR comments/approval) ---
# Optional. When set, `yarn issue:create` creates issues as the App; pr-review.js posts comments and approves PRs.
# Required App permissions: Issues (read & write), Pull requests (read & write), Metadata (read).
#
# Local (.env): use GITHUB_* or GH_*
#   GITHUB_APP_ID=123456
#   GITHUB_INSTALLATION_ID=12345678
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
#
# CI (GitHub Actions): secret names cannot start with GITHUB_. Use GH_* instead:
#   GH_APP_ID, GH_INSTALLATION_ID, GH_APP_PRIVATE_KEY
#
#   GITHUB_REPOSITORY=owner/repo  (optional; auto-set in Actions)
