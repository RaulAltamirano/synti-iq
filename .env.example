# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=syntiiq

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration (RS256)
JWT_PRIVATE_KEY_PATH=./keys/private_key_pkcs8.pem
JWT_PUBLIC_KEY_PATH=./keys/public_key.pem

# Password pepper (generate a secure random string)
PASSWORD_PEPPER=your_pepper_here

# User Business Owner (seed)
ADMIN_EMAIL=owner@syntiiq.com
ADMIN_PASSWORD=Admin123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Business Owner
ADMIN_BUSINESS_NAME=SyntiIQ Demo Store

# Mail Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=onboarding@resend.dev

# --- PR Review Pipeline (GitHub Actions) ---
# Configurar como Secrets en: Settings > Secrets and variables > Actions
# No usar en .env local; solo para CI
# SONAR_TOKEN=your_sonarcloud_token
# GEMINI_API_KEY=your_google_ai_api_key
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
