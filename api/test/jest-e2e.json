{
  "moduleFileExtensions": ["js", "json", "ts"],
  "modulePathIgnorePatterns": ["<rootDir>/../.worktrees/"],
  "watchPathIgnorePatterns": ["<rootDir>/../.worktrees/"],
  "rootDir": ".",
  "setupFiles": ["<rootDir>/jest-e2e-setup.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
