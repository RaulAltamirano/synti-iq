{
  "info": {
    "_postman_id": "synti-iq-api-base",
    "name": "Synti IQ API (Base)",
    "description": "Base template with shared scripts and variables. Do not edit directly - merged by build.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 🔄 Global Pre-Request Script",
          "// Automatically refreshes token if needed before protected requests",
          "",
          "const accessToken = pm.environment.get('access_token');",
          "const refreshToken = pm.environment.get('refresh_token');",
          "const requestUrl = pm.request.url.toString();",
          "",
          "// Skip token refresh for auth endpoints",
          "const isAuthRequest = requestUrl.includes('/auth/login') || ",
          "                     requestUrl.includes('/auth/signup') || ",
          "                     requestUrl.includes('/auth/register-business') || ",
          "                     requestUrl.includes('/auth/refresh');",
          "",
          "// Only refresh if we have refresh token but no access token",
          "// and this is not an auth request (cookies sent automatically by Postman)",
          "if (!isAuthRequest && refreshToken && !accessToken) {",
          "    console.log('🔄 Auto-refreshing access token...');",
          "    ",
          "    pm.sendRequest({",
          "        url: pm.environment.get('base_url') + '/api/auth/refresh',",
          "        method: 'POST',",
          "        header: {",
          "            'Content-Type': 'application/json'",
          "        }",
          "    }, function (err, res) {",
          "        if (err) {",
          "            console.error('❌ Token refresh error:', err);",
          "            return;",
          "        }",
          "        ",
          "        if (res && res.code >= 200 && res.code < 300) {",
          "            try {",
          "                // Extract tokens from cookies",
          "                if (res.cookies) {",
          "                    const accessTokenCookie = res.cookies.get('access_token');",
          "                    const refreshTokenCookie = res.cookies.get('refresh_token');",
          "                    ",
          "                    if (accessTokenCookie) {",
          "                        pm.environment.set('access_token', accessTokenCookie.value);",
          "                        console.log('✅ Access token refreshed from cookie');",
          "                    }",
          "                    ",
          "                    if (refreshTokenCookie) {",
          "                        pm.environment.set('refresh_token', refreshTokenCookie.value);",
          "                    }",
          "                }",
          "            } catch (parseError) {",
          "                console.error('Error parsing refresh response:', parseError);",
          "            }",
          "        } else {",
          "            console.warn('Token refresh failed:', res ? res.code : 'no response');",
          "        }",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 🧪 Global Test Script",
          "// Runs after every request to validate response",
          "",
          "// Test response time",
          "pm.test('⏱️ Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Test that response has a status code",
          "pm.test('✅ Status code exists', function () {",
          "    pm.expect(pm.response.code).to.be.a('number');",
          "});",
          "",
          "// Log 401 errors for debugging",
          "if (pm.response.code === 401) {",
          "    console.warn('⚠️ Unauthorized - Check if token is valid or expired');",
          "    console.warn('Current access_token:', pm.environment.get('access_token') ? 'Set' : 'Not set');",
          "}",
          "",
          "// Auto-refresh token on 401 (uses refresh_token cookie)",
          "if (pm.response.code === 401 && pm.environment.get('refresh_token')) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get('base_url') + '/api/auth/refresh',",
          "        method: 'POST',",
          "        header: {",
          "            'Content-Type': 'application/json'",
          "        }",
          "    }, function (err, res) {",
          "        if (res && res.code === 200 && res.cookies) {",
          "            const accessTokenCookie = res.cookies.get('access_token');",
          "            const refreshTokenCookie = res.cookies.get('refresh_token');",
          "            ",
          "            if (accessTokenCookie) {",
          "                pm.environment.set('access_token', accessTokenCookie.value);",
          "            }",
          "            ",
          "            if (refreshTokenCookie) {",
          "                pm.environment.set('refresh_token', refreshTokenCookie.value);",
          "            }",
          "            ",
          "            console.log('Token refreshed from cookie, please retry the request');",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
