VITE_UNSPLASH_ACCESS_KEY=tu_access_key_de_unsplash

# Google Maps JavaScript API: misma clave para mapa + autocompletado (Places).
# En Google Cloud Console habilita "Maps JavaScript API" y "Places API (New)".
# VITE_GOOGLE_MAPS_API_KEY=

# API (front)
#
# Desarrollo recomendado: NO definas VITE_API_BASE_URL. El front usa base `/api` y Vite hace proxy al API,
# así funciona igual con http://localhost:5173 y http://192.168.x.x:5173 (cookies y mismo origen).
# Destino del proxy (API Nest):
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
#
# Si defines VITE_API_BASE_URL, axios irá ahí directo (útil en build de producción o si no quieres proxy).
# Ojo: VITE_API_BASE_URL=http://localhost:3000/api rompe otros dispositivos en la LAN (localhost = ellos).
#
# Producción: URL absoluta del API, p. ej. VITE_API_BASE_URL=https://api.tudominio.com/api
# En el API, CORS_ORIGINS debe incluir el origen del front (sin barra final).
