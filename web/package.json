{
  "name": "synti-iq-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,cjs,mjs,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,cjs,mjs,json,css,md}\"",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook:$(node -p \"require('path').resolve('.storybook')\")",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc --noEmit",
    "quality": "yarn build && yarn lint && yarn type-check && yarn format:check && yarn test && yarn build-storybook",
    "pre-pr": "yarn quality"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@types/qrcode": "^1.5.6",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.13.4",
    "baseline-browser-mapping": "^2.9.19",
    "caniuse-lite": "^1.0.30001766",
    "font-awesome": "^4.7.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "secure-ls": "^2.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.2.1",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-onboarding": "^10.2.1",
    "@storybook/addon-vitest": "^10.2.1",
    "@storybook/vue3-vite": "^10.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "^10.4.23",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.2.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "storybook": "^10.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  }
}
