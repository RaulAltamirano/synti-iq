{
  "name": "synti-iq-api",
  "version": "0.0.1",
  "description": "SyntiIQ - Enterprise application built with NestJS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\"",
    "test": "jest && jest --config scripts/jest.config.js",
    "test:scripts": "jest --config scripts/jest.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage && jest --config scripts/jest.config.js --coverage && node scripts/merge-coverage.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "seed:all": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts all",
    "seed:permissions": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts permissions",
    "seed:groups": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts groups",
    "seed:roles": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts roles",
    "seed:users": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts users",
    "seed:subscription_plans": "ts-node -r tsconfig-paths/register src/database/scripts/seed-runner.ts subscription_plans",
    "postman:build": "node postman/build.js",
    "quality": "yarn build && yarn lint && yarn test && yarn format:check",
    "pre-pr": "yarn quality",
    "issue:create": "node scripts/create-github-issue.js"
  },
  "resolutions": {
    "eslint/**/minimatch": "3.1.4",
    "jest/**/minimatch": "3.1.4",
    "typeorm/**/minimatch": "9.0.7",
    "@typescript-eslint/parser/**/minimatch": "9.0.7",
    "@typescript-eslint/eslint-plugin/**/minimatch": "9.0.7",
    "@nestjs/cli/**/minimatch": "10.2.3",
    "multer": "2.1.1",
    "serialize-javascript": "7.0.3",
    "flatted": "3.4.2",
    "undici": "6.24.0",
    "eslint/**/ajv": "6.14.0",
    "@nestjs/cli/**/ajv": "8.18.0",
    "fork-ts-checker-webpack-plugin/**/ajv": "6.14.0",
    "qs": "6.14.2"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@nestjs-modules/ioredis": "^2.2.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation": "^0.213.0",
    "@opentelemetry/instrumentation-express": "^0.61.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@react-email/components": "^1.0.10",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^4.22.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.4",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@octokit/auth-app": "^8.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/passport": "^1.0.17",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "octokit": "^5.0.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "coverageProvider": "v8",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json"
    ],
    "testEnvironment": "node",
    "cacheDirectory": ".jest-cache",
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
